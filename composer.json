{
    "name": "arthur/pret-mat",
    "description": "Application web de prêt de matériel pour club",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "league/oauth2-google": "^4.0",
        "mongodb/mongodb": "^1.16 || ^2.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0",
            "ext-mongodb": "2.5.0"
        }
    }
}
